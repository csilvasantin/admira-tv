# Cloudflare Pages — caché + seguridad
# HTML siempre revalidado (los cambios se ven al instante); assets con caché.
# NOTA: sin X-Frame-Options — canal.html se EMBEBE a propósito (MUPI en clearchannel.tv,
# players de flota). Permissions-Policy no bloquea cámara (condicional la usa).
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# El chrome se pide siempre con ?v=<versión> → inmutable, cero revalidaciones.
/admira-nav.js
  Cache-Control: public, max-age=31536000, immutable

# EL TIPO SE DECLARA, NO SE HEREDA (13-ago-2026). /assets/admira-version-watch.js se
# estaba sirviendo como application/vnd.android.package-archive —el tipo de la APK— y
# con nosniff puesto arriba el navegador se NIEGA a ejecutarlo:
#   Refused to execute script … MIME type is not executable
# Resultado: el aviso de «versión nueva» de admira.tv no ha funcionado NUNCA. No es que
# avisara tarde: el vigilante jamás llegó a correr, y como es la única cosa en /assets,
# no rompió nada más y nadie lo notó. Declararlo aquí cierra la puerta a que una regla
# de otro tipo vuelva a envenenar la carpeta.
/assets/*
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=604800

# APK del player Android (distribución de flota): tipo MIME correcto + cache corto
# (la APK cambia poco pero queremos que una nueva versión llegue rápido a las tablets).
# RUTA EXACTA, no `/*.apk`: Cloudflare Pages solo entiende el comodín al FINAL del
# patrón, así que un `*` a mitad no acota por extensión — acaba pegando este tipo MIME
# a ficheros que no son la APK. Fue justo lo que le pasó al vigilante de versión.
/player/admira-player.apk
  Content-Type: application/vnd.android.package-archive
  Cache-Control: public, max-age=300
/player/android-release.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-store
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800

# El directorio y sus APIs nunca se pueden embeber ni cachear.
/tester/*
  Cache-Control: no-store
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; media-src 'self' blob:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer

/users/*
  Cache-Control: no-store, private
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# Xtore es un procesador local: no consume APIs privadas ni publica fotogramas.
# Los únicos recursos externos son librerías fijadas con SRI y pesos del detector.
/videoanalytics/xtore/*
  Cache-Control: no-store
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: display-capture=(self), camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.22.0/dist/tf.es2017.min.js https://cdn.jsdelivr.net/npm/@tensorflow-models/coco-ssd@2.2.3/dist/coco-ssd.min.js; style-src 'self' 'unsafe-inline'; connect-src https://storage.googleapis.com/tfjs-models/savedmodel/ssd_mobilenet_v2/; img-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
